# ========================
# GLOBAL SETTINGS
# ========================
COMPOSER_PROJECT_NAME=dockit
NETWORK_NAME=devnet
RESTART_POLICY=no

# ========================
# MYSQL
# ========================
MYSQL_VERSION=8.2.0
MYSQL_PORT=8080
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=devuser
MYSQL_PASSWORD=devpass
MYSQL_DATABASE=devdb

# ========================
# POSTGRES
# ========================
POSTGRES_VERSION=15-alpine
POSTGRES_PORT=8081
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=devdb

# ========================
# REDIS
# ========================
REDIS_VERSION=7-alpine
REDIS_PORT=8082

# ========================
# RABBITMQ
# ========================
RABBITMQ_VERSION=3.12.13-management
RABBITMQ_PORT=8083
RABBITMQ_MANAGEMENT_PORT=8084
RABBITMQ_DEFAULT_USER=devuser
RABBITMQ_DEFAULT_PASS=devpass

# ========================
# KEYCLOAK
# ========================
KEYCLOAK_VERSION=latest
KEYCLOAK_PORT=8085
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak

# ========================
# SONARQUBE
# ========================
SONARQUBE_VERSION=community
SONARQUBE_PORT=8088
SONARQUBE_DB=sonarqube
SONARQUBE_DB_USER=devuser
SONARQUBE_DB_PASSWORD=devpass

# ========================
# FRANKENPHP
# ========================
FRANKENPHP_HTTP_PORT=8086
FRANKENPHP_PROJECT_PATH=../playground/php
FRANKENPHP_DOCUMENT_ROOT=public
FRANKENPHP_SERVER_NAME=localhost
